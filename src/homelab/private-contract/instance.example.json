{
  "contract_version": 1,
  "site": {
    "label": "example-site",
    "timezone": "Etc/UTC"
  },
  "identity": {
    "dns_domain": "lab.home.arpa",
    "kerberos_realm": "LAB.HOME.ARPA",
    "netbios_name": "EXAMPLE"
  },
  "services": {
    "bootstrap_dc_fqdn": "bootstrap-dc.lab.home.arpa",
    "permanent_dc_fqdn": "dc1.lab.home.arpa",
    "boot_fqdn": "boot.lab.home.arpa"
  },
  "networks": [
    {
      "id": "managed-clients",
      "purpose": "Synthetic managed-client example",
      "vlan": 20,
      "cidr": "192.0.2.0/28",
      "gateway": "192.0.2.1",
      "dhcp": {
        "first": "192.0.2.5",
        "last": "192.0.2.14"
      },
