{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telos.invalid/homelab/private-contract/instance.schema.json",
  "title": "Telos private homelab instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "site",
    "identity",
    "networks",
    "people",
    "machines",
    "secret_refs"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "timezone"],
      "properties": {
        "label": { "$ref": "#/$defs/name" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dns_domain", "kerberos_realm", "netbios_name"],
      "properties": {
        "dns_domain": { "$ref": "#/$defs/dnsName" },
        "kerberos_realm": { "type": "string", "pattern": "^[A-Z0-9.-]+$" },
        "netbios_name": { "type": "string", "pattern": "^[A-Z0-9-]{1,15}$" }
      }
    },
    "networks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "vlan", "cidr", "gateway", "dhcp"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "purpose": { "type": "string", "minLength": 1 },
          "vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
          "cidr": {
            "type": "string",
            "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
          },
          "gateway": { "type": "string", "format": "ipv4" },
          "dhcp": {
            "type": "object",
            "additionalProperties": false,
            "required": ["first", "last"],
            "properties": {
              "first": { "type": "string", "format": "ipv4" },
              "last": { "type": "string", "format": "ipv4" }
            }
          },
          "ssid": { "type": "string", "minLength": 1 },
          "wifi_secret_ref": { "$ref": "#/$defs/secretRef" }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "groups"],
        "properties": {
          "account": { "$ref": "#/$defs/account" },
          "groups": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/name" }
          },
          "enabled": { "type": "boolean", "default": true }
        }
      }
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostname", "role", "network", "mac_addresses"],
        "properties": {
          "hostname": { "$ref": "#/$defs/dnsLabel" },
          "role": {
            "enum": ["bootstrap-controller", "controller", "workstation", "storage"]
          },
          "network": { "$ref": "#/$defs/name" },
          "ipv4": { "type": "string", "format": "ipv4" },
          "mac_addresses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$"
            }
          },
          "disk_serials": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "profile": { "$ref": "#/$defs/name" }
        }
      }
    },
    "secret_refs": {
      "type": "object",
      "description": "Logical name to encrypted-store locator. Values are references, never secrets.",
      "additionalProperties": { "$ref": "#/$defs/secretRef" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "account": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,62}$" },
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,14}$" },
    "dnsName": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "secretRef": {
      "type": "string",
      "pattern": "^(sops|pass|vault|systemd-creds)://\\S+$"
    }
  }
}
