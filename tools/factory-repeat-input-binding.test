#!/usr/bin/env python3
"""CLI regression: actual copied bytes, reselection, malformed and missing inputs."""
import json
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from homelab.tests.test_pxe_release_set import ReleaseSetTests

TOOL = Path(__file__).with_name("factory-repeat-input-binding")
subprocess.run([str(TOOL), "--help"], check=True, capture_output=True)
fixture = ReleaseSetTests()
fixture.setUp()
try:
    selected = fixture.build()
    publication = fixture.root / "publication"
    publication.mkdir()
    shutil.copy2(selected / "release-set.json", publication / "release-set.json")
    shutil.copytree(selected / "targets", publication / "www")

    def invoke(*paths, code=0):
        result = subprocess.run([str(TOOL), "--json", "--releases", str(fixture.releases),
                                 *(str(path) for path in paths)], capture_output=True,
                                text=True, cwd=fixture.root)
        assert result.returncode == code, result
        return json.loads(result.stdout)

    first = invoke(publication)
    assert first["v"] == 1 and first["findings"] == 0, first
    assert first == invoke(publication), "unchanged inputs must be deterministic"
    fixture.build(fixture.builder(version="20260727.002"), version="20260727.002")
    mismatch = invoke(publication, code=1)
    assert mismatch["publications"][0]["identity"]["version"] == "20260727.001"
    assert mismatch["expected"]["version"] == "20260727.002"
    leaf = publication / "www/controller/20260727.001/boot.ipxe"
    leaf.write_text("tampered payload\n")
    failed = invoke(publication, fixture.root / "missing", code=1)
    assert failed["findings"] == 2 and all("error" in row for row in failed["publications"])
    (fixture.releases / "selected-release-set.json").write_text("invalid json")
    invalid = subprocess.run([str(TOOL), "--json", "--releases", str(fixture.releases),
                              str(publication)], capture_output=True, text=True)
    assert invalid.returncode == 2 and not invalid.stdout, invalid
    assert json.loads(invalid.stderr)["status"] == "error", invalid
finally:
    fixture.doCleanups()
