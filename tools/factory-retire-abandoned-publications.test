#!/usr/bin/env python3
"""Run retirement regressions exclusively against synthetic temporary state."""
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
subprocess.run([str(root / "tools/factory-retire-abandoned-publications"), "--help"],
               check=True, capture_output=True)
subprocess.run([sys.executable, "-m", "unittest", "homelab.tests.test_factory_retire_abandoned_publications"],
               cwd=root, check=True)
