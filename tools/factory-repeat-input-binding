#!/usr/bin/env python3
"""Validate staged publication release bytes against the selected release.

Usage: tools/factory-repeat-input-binding [--json] [--releases PATH] PUBLICATION [PUBLICATION ...]
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import sys

REPOSITORY = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY))

from homelab.lib import pxe_release_set
from homelab.vm import factory_publication


def run(releases: Path, publications: list[Path]) -> dict:
    selection = (releases / pxe_release_set.SELECTED).read_bytes()
    descriptor = json.loads(selection)
    selected = pxe_release_set.selected_release_set(releases)
    raw = (selected / pxe_release_set.MANIFEST).read_bytes()
    aggregate = json.loads(raw)
    expected = {
        "version": aggregate["version"],
        "manifest_sha256": hashlib.sha256(raw).hexdigest(),
        "media_seal_sha256": aggregate["media_seal_sha256"],
    }
    if (descriptor["version"] != expected["version"]
            or descriptor["manifest_sha256"] != expected["manifest_sha256"]
            or selection != (releases / pxe_release_set.SELECTED).read_bytes()):
        raise ValueError("selected release changed while reading its identity")
    rows = []
    for publication in publications:
        row = {"publication": str(publication)}
        try:
            actual = factory_publication.publication_release_identity(publication)
            row.update(identity=actual, matches=actual == expected)
        except (OSError, ValueError, RuntimeError) as error:
            row.update(matches=False, error=str(error))
        rows.append(row)
    return {"expected": expected, "publications": rows,
            "findings": sum(not row["matches"] for row in rows)}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="emit cli-v1 JSON")
    parser.add_argument("--releases", type=Path,
                        default=REPOSITORY / "homelab/var/pxe",
                        help="PXE root containing selected-release-set.json")
    parser.add_argument("publications", type=Path, nargs="+",
                        help="staging directories containing release-set.json and www/")
    args = parser.parse_args(argv)
    try:
        payload = run(args.releases, args.publications)
    except (OSError, ValueError, RuntimeError, KeyError) as error:
        if args.json:
            print(json.dumps({"v": 1, "status": "error", "code": "input",
                              "error": str(error)}, sort_keys=True,
                             separators=(",", ":")), file=sys.stderr)
        else:
            print(f"factory-repeat-input-binding: {error}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps({"v": 1, **payload}, sort_keys=True, separators=(",", ":")))
    else:
        print(f"expected\t{payload['expected']['version']}\t"
              f"{payload['expected']['manifest_sha256']}")
        for row in payload["publications"]:
            print(f"{'MATCH' if row['matches'] else 'FAIL'}\t{row['publication']}")
            if "error" in row:
                print(f"error\t{row['error']}")
    return 1 if payload["findings"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
