#!/bin/sh
# Test for tools/lab-state-test-audit: exit 0 = pass (the stable gate).
set -eu

# Resolved sibling path: keeps working after a cd into a sandbox.
tool="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/lab-state-test-audit"

# --help always works.
"$tool" --help >/dev/null

# Work in a throwaway sandbox; the trap cleans up on any exit. The sandbox is
# a miniature repository: its own lab-state trees and a homelab/tests package.
sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"
mkdir -p homelab/tests homelab/var homelab/instance build out
: > homelab/tests/__init__.py
printf 'x\n' > homelab/var/x
printf 'y\n' > build/y

cat > homelab/tests/test_clean.py <<'PY'
import shutil
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


class Clean(unittest.TestCase):
    def test_sandboxed(self):
        # A sandbox of the test's own that holds build/ and homelab/var/: an
        # absolute path outside the repository is not lab state, and the
        # dir_fd-relative cleanup (rmdir("build", dir_fd=...)) is not the
        # repository's build/ either.
        with tempfile.TemporaryDirectory() as scratch:
            nested = Path(scratch, "build", "homelab", "var")
            nested.mkdir(parents=True)
            (nested / "f").write_text("f\n")
            self.assertTrue((nested / "f").exists())
            shutil.copytree(Path(scratch, "build"), Path(scratch, "copy"))
        self.assertTrue((ROOT / "homelab" / "tests").is_dir())

    def test_dry_run_mentions(self):
        # A child that names lab state without touching it, as `make -n`
        # does: an advisory mention, never a touch.
        print("test output never reaches the tool's stdout")
        subprocess.run(
            [sys.executable, "-c", "print('nor child output')",
             "--state-dir=build/y"],
            check=True, cwd=ROOT)
PY

# Clean: exit 0, nothing touched, the argv mention reported but not counted,
# and the test's own output kept off stdout (the JSON parses).
"$tool" --json > out/clean.json
grep -q '"v":1' out/clean.json
python3 - <<'PY'
import json
d = json.load(open("out/clean.json"))
assert d["status"] == "ok", d
assert d["touches"] == [], d
assert d["mentions"] == [{
    "event": "subprocess.argv", "path": "build/y",
    "test": "homelab.tests.test_clean.Clean.test_dry_run_mentions"}], d
assert d["tests"] == {"errors": 0, "failures": 0, "ran": 2, "skipped": 0}, d
assert d["failed"] == [], d
PY

cat > homelab/tests/test_offending.py <<'PY'
import os
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
# An import-time probe of the private overlay: no test is running yet.
OVERLAY = os.path.exists(ROOT / "homelab" / "instance" / "z")


class Fixture(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.listing = os.listdir(ROOT / "build")

    def test_listing(self):
        self.assertIn("y", self.listing)


class Offending(unittest.TestCase):
    def test_opens_var(self):
        with open("homelab/var/x", encoding="utf-8") as handle:
            self.assertEqual("x\n", handle.read())

    def test_stats_build(self):
        self.assertTrue((ROOT / "build" / "y").exists())
PY

# Offending: exit 1, every touch attributed -- to the running test, to the
# class fixture, and to the module whose import made it.
if "$tool" --json --repo "$sandbox" > out/touched.json; then exit 1; else test $? = 1; fi
python3 - <<'PY'
import json
d = json.load(open("out/touched.json"))
assert d["status"] == "touched", d
module = "homelab.tests.test_offending"
assert d["touches"] == [
    {"event": "os.stat", "path": "homelab/instance/z",
     "test": f"<import {module}>"},
    {"event": "os.listdir", "path": "build",
     "test": f"{module}.Fixture.setUpClass"},
    {"event": "open", "path": "homelab/var/x",
     "test": f"{module}.Offending.test_opens_var"},
    {"event": "os.stat", "path": "build/y",
     "test": f"{module}.Offending.test_stats_build"},
], d["touches"]
assert d["tests"]["ran"] == 5, d
PY

# Byte-stable for unchanged inputs.
if "$tool" --json > out/second.json; then exit 1; fi
cmp out/touched.json out/second.json

# The plain output: one line per touch and mention, then the counters.
if "$tool" > out/plain.txt; then exit 1; fi
test "$(grep -c '^touch	' out/plain.txt)" = 4
grep -q '^touch	homelab.tests.test_offending.Offending.test_opens_var	open	homelab/var/x$' out/plain.txt
grep -q '^mention	' out/plain.txt
grep -q '^ran	5$' out/plain.txt
grep -q '^touches	4$' out/plain.txt

# Named tests instead of discovery; the module's import-time touch comes along.
if "$tool" --json homelab.tests.test_offending.Offending.test_stats_build \
        > out/named.json; then exit 1; fi
python3 - <<'PY'
import json
d = json.load(open("out/named.json"))
assert [t["path"] for t in d["touches"]] == [
    "homelab/instance/z", "build/y"], d
assert d["tests"]["ran"] == 1, d
PY

# A failing test is reported but does not change the verdict: the audit is
# about touches.
mkdir -p failing/homelab/tests
: > failing/homelab/tests/__init__.py
cat > failing/homelab/tests/test_fails.py <<'PY'
import unittest


class Fails(unittest.TestCase):
    def test_fails(self):
        self.fail("deliberately")
PY
"$tool" --json --repo failing > out/failing.json
python3 - <<'PY'
import json
d = json.load(open("out/failing.json"))
assert d["status"] == "ok", d
assert d["failed"] == ["homelab.tests.test_fails.Fails.test_fails"], d
assert d["tests"]["failures"] == 1, d
PY

# Fail-closed, cli-v1 error contract: exit 70, one JSON object on stderr,
# nothing on stdout -- never a vacuous clean pass.
refused() {
    if "$tool" --json "$@" > out/stdout.txt 2> out/stderr.txt; then exit 1
    else test $? = 70; fi
    test ! -s out/stdout.txt
    grep -q '"status":"error"' out/stderr.txt
    grep -q '"v":1' out/stderr.txt
}
refused --repo absent                            # no repository
mkdir empty
refused --repo empty                             # no homelab/tests
mkdir -p bare/homelab/tests
: > bare/homelab/tests/__init__.py
refused --repo bare                              # no tests found
refused homelab.tests.test_absent                # unimportable module
grep -q 'homelab.tests.test_absent' out/stderr.txt
