#!/bin/sh
# Test for tools/doc-make-target-drift: exit 0 = pass (the stable gate).
set -eu

# Resolved sibling path: keeps working after a cd into a sandbox.
tool="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/doc-make-target-drift"

# --help always works.
"$tool" --help >/dev/null

# Work in a throwaway sandbox; the trap cleans up on any exit.
sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"

mkdir docs
cat > Makefile <<'MAKE'
homelab-real-thing:
	@true

homelab-family-prepare:
	@true

homelab-family-run:
	@true

not-a-homelab-target:
	@true
MAKE

# A clean document: a real target, and a family stem whose leaves exist.
cat > docs/clean.md <<'MD'
# Clean

Run `homelab-real-thing` first. The `homelab-family` lane is
`homelab-family-{prepare,run}`.
MD
"$tool" --json --makefile Makefile --docs docs > out.json
grep -q '"v":1' out.json
python3 - <<'PY'
import json
d = json.load(open("out.json"))
assert d["stale"] == [], d
assert d["status"] == "ok", d
assert d["defined"] == 3, d          # only the homelab-* definitions count
# homelab-real-thing, homelab-family (stem), homelab-family-prepare/-run
assert d["documented"] == 4, d
PY

# Check-style contract: a stale citation is exit 1 with the finding located.
cat > docs/stale.md <<'MD'
# Stale

Run `homelab-vanished` to finish.
MD
if "$tool" --json --makefile Makefile --docs docs > out.json; then exit 1; else test $? = 1; fi
python3 - <<'PY'
import json
d = json.load(open("out.json"))
assert d["status"] == "stale", d
found = [f for f in d["stale"] if f["target"] == "homelab-vanished"]
assert len(found) == 1, d
assert found[0]["document"] == "docs/stale.md", found
assert found[0]["lines"] == [3], found
PY
rm docs/stale.md

# A reserved declaration covers its whole paragraph, including a list that
# runs onto following lines -- otherwise an honest disclosure reads as drift.
cat > docs/reserved.md <<'MD'
# Reserved

These names are reserved and not implemented as Make targets:
`homelab-someday-one`,
`homelab-someday-two`.
MD
"$tool" --json --makefile Makefile --docs docs > out.json
python3 -c '
import json
assert json.load(open("out.json"))["stale"] == [], open("out.json").read()
'
rm docs/reserved.md

# A proposed-surface marker covers up to the next heading, and stops there.
cat > docs/proposed.md <<'MD'
# Surface

<!-- doc-make-target-drift: proposed -->
| Target | Result |
|---|---|
| `homelab-planned-one` | someday |

## Real

Run `homelab-escaped` now.
MD
if "$tool" --json --makefile Makefile --docs docs > out.json; then exit 1; else test $? = 1; fi
python3 - <<'PY'
import json
d = json.load(open("out.json"))
names = sorted(f["target"] for f in d["stale"])
# The marked table is exempt; the citation after the next heading is not.
assert names == ["homelab-escaped"], d
PY
rm docs/proposed.md

# A wildcard family is its stem: judged against the targets it covers.
cat > docs/wildcard.md <<'MD'
# Wildcard

Every `homelab-family-*` target is dry-run by default; `homelab-gone-*` is not.
MD
if "$tool" --json --makefile Makefile --docs docs > out.json; then exit 1; else test $? = 1; fi
python3 - <<'PY'
import json
d = json.load(open("out.json"))
assert [f["target"] for f in d["stale"]] == ["homelab-gone"], d
PY
rm docs/wildcard.md

# An installed helper under a path is not a Make target.
cat > docs/helper.md <<'MD'
# Helper

Run `/usr/local/sbin/homelab-network-thing` as the operator.
MD
"$tool" --json --makefile Makefile --docs docs > out.json
python3 -c '
import json
assert json.load(open("out.json"))["stale"] == [], open("out.json").read()
'
rm docs/helper.md

# Byte-stable for unchanged inputs, and sorted independently of filesystem order.
"$tool" --json --makefile Makefile --docs docs > first.json
"$tool" --json --makefile Makefile --docs docs > second.json
cmp first.json second.json

# The plain output reports the three counters.
"$tool" --makefile Makefile --docs docs > plain.txt
grep -q '^defined	3$' plain.txt
grep -q '^stale	0$' plain.txt

# Fail-closed, cli-v1 error contract: a missing Makefile is an error on stderr
# with nothing on stdout, and exit 70 -- never a vacuous clean pass.
if "$tool" --json --makefile absent-Makefile --docs docs > stdout.txt 2> stderr.txt; then exit 1; fi
test ! -s stdout.txt
grep -q '"status":"error"' stderr.txt
grep -q '"v":1' stderr.txt

# A docs path that is not a directory is refused the same way.
if "$tool" --json --makefile Makefile --docs Makefile > /dev/null 2> stderr.txt; then exit 1; fi
grep -q '"status":"error"' stderr.txt
