# The provisioning environment gets its address from the Controller it is
# booting from. Wired only: network installation is wired (ADR 0050), and the
# image carries no wireless firmware configuration to make it work otherwise.
[Match]
Type=ether
# Exclude virtual Ethernet interfaces.
Kind=!*

[Link]
RequiredForOnline=routable

[Network]
DHCP=yes

[DHCPv4]
RouteMetric=100
