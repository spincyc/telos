{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telos.local/schemas/guest-progress-event-v1.json",
  "title": "Telos guest progress event v1",
  "description": "Closed envelope for one diagnostic guest progress event. Validity here is necessary but never sufficient: the transport additionally requires RFC 8785 canonical encoding, a verified HMAC, an in-registry attempt/producer/phase binding, and a monotonic sequence, none of which a schema can express. No event that validates against this schema is acceptance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "attempt",
    "boot_id",
    "sequence",
    "phase",
    "status",
    "mac"
  ],
  "properties": {
    "specversion": {
      "description": "Telos guest-progress schema version.",
      "const": "1.0"
    },
    "id": {
      "description": "Attempt-scoped canonical lowercase event UUID.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source": {
      "description": "Fixed role/OS producer identifier, never a private hostname.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "type": {
      "description": "Allowlisted event type.",
      "enum": [
        "sync",
        "phase-started",
        "heartbeat",
        "phase-finished",
        "phase-failed",
        "diagnostic-ready"
      ]
    },
    "time": {
      "description": "Guest UTC timestamp for correlation only; host receive time controls deadlines.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z$"
    },
    "attempt": {
      "description": "Opaque public attempt identifier assigned by the host.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "boot_id": {
      "description": "Opaque per-boot value; changes across reboot.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sequence": {
      "description": "Strictly increasing within (attempt, boot_id, producer).",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "description": "Allowlisted factory phase, or null where the type does not use one.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "description": "Exact type-dependent coordinate.",
      "enum": [
        "starting",
        "active",
        "complete",
        "failed",
        "ready"
      ]
    },
    "progress": {
      "description": "Display only; never used to infer completion.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "nonce": {
      "description": "Host-supplied synchronisation nonce; permitted only on sync.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "diagnostic": {
      "description": "Identifier and digest of a secret-free bounded receipt, never its contents.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mac": {
      "description": "Canonical Base64 HMAC-SHA-256 over the domain-separated JCS encoding with mac omitted.",
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    }
  },
  "allOf": [
    {
      "description": "sync carries the nonce and no phase.",
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "sync"
          }
        }
      },
      "then": {
        "required": [
          "nonce"
        ],
        "properties": {
          "status": {
            "const": "starting"
          },
          "phase": {
            "type": "null"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "nonce"
          ]
        }
      }
    },
    {
      "description": "phase-started is active on a named phase.",
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "phase-started"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "active"
          },
          "phase": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "heartbeat is active on a named phase.",
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "heartbeat"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "active"
          },
          "phase": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "phase-finished is complete on a named phase.",
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "phase-finished"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete"
          },
          "phase": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "phase-failed is failed on a named phase.",
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "phase-failed"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "failed"
          },
          "phase": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "diagnostic-ready is ready and carries bounded receipt metadata.",
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "diagnostic-ready"
          }
        }
      },
      "then": {
        "required": [
          "diagnostic"
        ],
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      }
    }
  ]
}
