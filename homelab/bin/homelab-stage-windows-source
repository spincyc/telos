#!/usr/bin/env python3
"""Stage a verified read-only Windows installation source from a UDF ISO."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import windows_install_source  # noqa: E402
import windows_iso  # noqa: E402


def require_ignored_output(path: Path) -> None:
    repository = Path(__file__).resolve().parents[2]
    output = path.absolute()
    result = subprocess.run(
        ["git", "-C", str(repository), "check-ignore", "--quiet", str(output)],
        check=False,
    )
    if result.returncode != 0:
        raise windows_install_source.InstallSourceError(
            f"output must be covered by repository ignore rules: {output}"
        )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--iso", type=Path, required=True)
    parser.add_argument("--expected-sha256", required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    require_ignored_output(args.output)
    receipt = windows_install_source.stage(
        args.iso, args.output, args.expected_sha256
    )
    print(json.dumps(receipt, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (
        OSError,
        subprocess.CalledProcessError,
        windows_iso.VerificationError,
        windows_install_source.InstallSourceError,
    ) as exc:
        raise SystemExit(f"error: {exc}")
