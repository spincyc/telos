#!/usr/bin/env python3
"""Verify a local Windows 11 Pro ISO before it enters the build."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import windows_iso  # noqa: E402


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--iso", required=True, type=Path)
    parser.add_argument(
        "--sha256",
        required=True,
        help="expected SHA-256 from a trusted, independent source",
    )
    parser.add_argument(
        "--receipt",
        type=Path,
        help="atomically write the successful machine-readable receipt",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    receipt = windows_iso.verify(args.iso, args.sha256)
    if args.receipt is not None:
        destination = args.receipt.absolute()
        destination.parent.mkdir(parents=True, exist_ok=True)
        if destination.is_symlink():
            raise OSError(f"receipt must not be a symbolic link: {destination}")
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=destination.parent,
            prefix=f".{destination.name}.",
            delete=False,
        ) as stream:
            temporary = Path(stream.name)
            os.chmod(temporary, 0o600)
            json.dump(receipt, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        try:
            os.replace(temporary, destination)
        finally:
            temporary.unlink(missing_ok=True)
    print(json.dumps(receipt, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (
        OSError,
        subprocess.CalledProcessError,
        windows_iso.VerificationError,
    ) as exc:
        raise SystemExit(f"error: {exc}")
