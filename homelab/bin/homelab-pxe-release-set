#!/usr/bin/env python3
"""Build, verify, or select one transactional factory PXE release set."""

from __future__ import annotations

import argparse
import hashlib
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
sys.path.insert(0, str(ROOT / "pxe"))
sys.path.insert(0, str(ROOT / "pxe/windows"))

import media_seal  # noqa: E402
import pxe_release_set  # noqa: E402
import arch_workstation  # noqa: E402
from targets import controller  # noqa: E402
import stage as windows_stage  # noqa: E402


def media_inventory(args: argparse.Namespace) -> dict:
    return media_seal.inventory(
        arch_iso=args.arch_iso,
        arch_receipt=args.arch_receipt,
        windows_iso=args.windows_iso,
        windows_provenance=args.windows_provenance,
        windows_verification=args.windows_verification,
        windows_install_source_path=args.windows_install_source,
        wimboot=args.wimboot,
        wimboot_metadata=args.wimboot_metadata,
    )


def add_media(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--seal", type=Path, required=True)
    parser.add_argument("--arch-iso", type=Path, required=True)
    parser.add_argument("--arch-receipt", type=Path, required=True)
    parser.add_argument("--windows-iso", type=Path, required=True)
    parser.add_argument("--windows-provenance", type=Path, required=True)
    parser.add_argument("--windows-verification", type=Path, required=True)
    parser.add_argument("--windows-install-source", type=Path, required=True)
    parser.add_argument("--wimboot", type=Path, required=True)
    parser.add_argument("--wimboot-metadata", type=Path, required=True)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    build = commands.add_parser("build")
    build.add_argument("--releases", type=Path, required=True)
    build.add_argument("--version", required=True)
    build.add_argument("--controller-source", type=Path, required=True)
    build.add_argument("--arch-source", type=Path, required=True)
    build.add_argument("--base-url", required=True)
    add_media(build)
    verify = commands.add_parser("verify")
    verify.add_argument("release_set", type=Path)
    verify.add_argument("--seal", type=Path)
    select = commands.add_parser("select")
    select.add_argument("--releases", type=Path, required=True)
    select.add_argument("--version", required=True)
    args = parser.parse_args()

    if args.command == "verify":
        expected_seal = sha256(args.seal) if args.seal else None
        problems = pxe_release_set.verify(
            args.release_set,
            expected_media_seal_sha256=expected_seal,
        )
        if problems:
            print("\n".join(problems), file=sys.stderr)
            return 1
        print(f"verified {args.release_set}")
        return 0
    if args.command == "select":
        print(pxe_release_set.select(args.releases, args.version))
        return 0

    inventory = media_inventory(args)
    media_seal.verify(args.seal, inventory)
    base = args.base_url.rstrip("/")

    def stage_leaves(root: Path) -> dict[str, Path]:
        return {
            "controller": controller.stage(
                args.controller_source, root, args.version,
                f"{base}/controller/{args.version}",
            ),
            "arch-workstation": arch_workstation.stage(
                source=args.arch_source, releases=root, version=args.version,
                base_url=base,
            ),
            "windows": windows_stage.stage(argparse.Namespace(
                iso=args.windows_iso,
                wimboot=args.wimboot,
                wimboot_metadata=args.wimboot_metadata,
                output=root / "windows",
                release=args.version,
                base_url=f"{base}/windows",
            )),
        }

    result = pxe_release_set.build(
        args.releases, args.version, args.seal, inventory, stage_leaves)
    print(result)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (
        OSError, ValueError, RuntimeError, media_seal.SealError,
        pxe_release_set.ReleaseSetError,
    ) as exc:
        raise SystemExit(f"error: {exc}")
