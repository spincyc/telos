#!/usr/bin/env python3
"""Publish or roll back an immutable PXE release over SSH."""

from __future__ import annotations

import argparse
import json
import re
import secrets
import shlex
import subprocess
import sys
from pathlib import Path, PurePosixPath

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import pxe_release  # noqa: E402

REMOTE = re.compile(
    r"^(?:[A-Za-z0-9][A-Za-z0-9_.-]*@)?[A-Za-z0-9][A-Za-z0-9_.-]*$")
REMOTE_PATH = re.compile(r"^/[A-Za-z0-9._/-]+$")
TARGETS = ("controller", "arch-workstation", "windows")


def destination(value: str) -> tuple[str, PurePosixPath]:
    try:
        host, raw_path = value.split(":", 1)
    except ValueError as error:
        raise argparse.ArgumentTypeError("destination must be HOST:/absolute/path") from error
    path = PurePosixPath(raw_path)
    if (
        not REMOTE.fullmatch(host)
        or not REMOTE_PATH.fullmatch(raw_path)
        or not path.is_absolute()
        or any(part in ("", ".", "..") for part in raw_path.split("/")[1:])
    ):
        raise argparse.ArgumentTypeError("destination must be a safe HOST:/absolute/path")
    return host, path


def run(
    command: list[str],
    *,
    apply: bool,
    capture: bool = False,
    check: bool = True,
) -> str:
    if not apply:
        print(shlex.join(command))
        return ""
    result = subprocess.run(
        command, check=check, text=True, capture_output=capture)
    return result.stdout if capture else ""


def release_identity(release: Path) -> tuple[str, str]:
    problems = pxe_release.verify(release)
    if problems:
        raise ValueError("local release failed verification:\n" + "\n".join(problems))
    manifest = json.loads((release / pxe_release.MANIFEST).read_text())
    target = manifest.get("target")
    version = manifest.get("version")
    if target not in TARGETS:
        raise ValueError("manifest target is not a deployable PXE target")
    if not isinstance(version, str) or not pxe_release.VERSION_PATTERN.fullmatch(version):
        raise ValueError("manifest version must have form YYYYMMDD.NNN")
    if release.parent.name != target or release.name != version:
        raise ValueError("release path does not match manifest identity")
    return target, version


def lock_paths(target_root: PurePosixPath, token: str) -> tuple[PurePosixPath, PurePosixPath]:
    lock = target_root / ".deploy.lock"
    return lock, lock / token


def cleanup(host: str, incoming: PurePosixPath, lock: PurePosixPath,
            owner: PurePosixPath) -> None:
    command = (
        f"rm -rf -- {shlex.quote(str(incoming))}; "
        f"if test -f {shlex.quote(str(owner))}; then "
        f"rm -rf -- {shlex.quote(str(lock))}; fi"
    )
    for _ in range(3):
        result = subprocess.run(
            ["ssh", host, command], check=False, text=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if result.returncode == 0:
            return


def remote_verify(release: PurePosixPath, target: str, version: str) -> str:
    """Return a remote Python command that verifies every release byte."""
    program = """\
import hashlib,json,pathlib,sys
r=pathlib.Path(sys.argv[1]); target=sys.argv[2]; version=sys.argv[3]
def fail(message): raise SystemExit(message)
try: manifest=json.loads((r/'release.json').read_text())
except Exception as error: fail(f'cannot read release manifest: {error}')
if manifest.get('schema') != 1: fail('wrong release schema')
if manifest.get('target') != target: fail('wrong release target')
if manifest.get('version') != version: fail('wrong release version')
artifacts=manifest.get('artifacts')
if not isinstance(artifacts,dict): fail('invalid artifact inventory')
actual=set()
for path in r.rglob('*'):
    if path.is_symlink(): fail(f'symlink in release: {path}')
    if path.is_file() and path.name != 'release.json':
        actual.add(path.relative_to(r).as_posix())
if actual != set(artifacts): fail('artifact inventory differs')
for name,record in artifacts.items():
    relative=pathlib.PurePosixPath(name)
    if relative.is_absolute() or '..' in relative.parts: fail('unsafe artifact path')
    path=r/relative
    if not isinstance(record,dict): fail(f'invalid record: {name}')
    if path.stat().st_size != record.get('size'): fail(f'size mismatch: {name}')
    digest=hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1048576),b''): digest.update(chunk)
    digest=digest.hexdigest()
    if digest != record.get('sha256'): fail(f'checksum mismatch: {name}')
"""
    return " ".join((
        "python3", "-c", shlex.quote(program), shlex.quote(str(release)),
        shlex.quote(target), shlex.quote(version)))


def publish(args) -> None:
    release = args.release.resolve()
    target, version = release_identity(release)
    host, root = args.destination
    target_root = root / target
    token = secrets.token_hex(12)
    incoming = target_root / f".incoming-{version}-{token}"
    final = target_root / version
    lock, owner = lock_paths(target_root, token)
    preflight = (
        f"set -eu; mkdir -p {shlex.quote(str(target_root))}; "
        f"mkdir {shlex.quote(str(lock))}; "
        f": > {shlex.quote(str(owner))}; "
        f"test ! -e {shlex.quote(str(incoming))}; "
        f"test ! -e {shlex.quote(str(final))}"
    )
    acquired = False
    try:
        acquired = args.apply
        run(["ssh", host, preflight], apply=args.apply)
        run(
            ["rsync", "-a", "--checksum", "--protect-args",
             f"{release}/", f"{host}:{incoming}/"],
            apply=args.apply,
        )
        differences = run(
            ["rsync", "-ani", "--checksum", "--delete", "--protect-args",
             f"{release}/", f"{host}:{incoming}/"],
            apply=args.apply,
            capture=True,
        )
        if args.apply and differences.strip():
            raise RuntimeError("remote verification differs:\n" + differences)
        promote = (
            f"set -eu; test -f {shlex.quote(str(owner))}; "
            f"{remote_verify(incoming, target, version)}; "
            f"mv {shlex.quote(str(incoming))} {shlex.quote(str(final))}; "
            f"chmod -R a-w {shlex.quote(str(final))}; "
            f"ln -sfn {shlex.quote(version)} "
            f"{shlex.quote(str(target_root / '.current.next'))}; "
            f"mv -Tf {shlex.quote(str(target_root / '.current.next'))} "
            f"{shlex.quote(str(target_root / 'current'))}; "
            f"test \"$(readlink {shlex.quote(str(target_root / 'current'))})\" = "
            f"{shlex.quote(version)}; rm -rf -- {shlex.quote(str(lock))}"
        )
        run(["ssh", host, promote], apply=args.apply)
        acquired = False
    finally:
        if acquired:
            cleanup(host, incoming, lock, owner)
    print(("published" if args.apply else "dry-run publish") + f" {target}/{version}")


def rollback(args) -> None:
    host, root = args.destination
    target_root = root / args.target
    release = target_root / args.version
    token = secrets.token_hex(12)
    lock, owner = lock_paths(target_root, token)
    command = (
        f"set -eu; mkdir {shlex.quote(str(lock))}; "
        f": > {shlex.quote(str(owner))}; "
        f"release_lock() {{ rm -rf -- {shlex.quote(str(lock))}; }}; "
        f"trap release_lock EXIT HUP INT TERM; "
        f"{remote_verify(release, args.target, args.version)}; "
        f"ln -sfn {shlex.quote(args.version)} {shlex.quote(str(target_root / '.current.next'))}; "
        f"mv -Tf {shlex.quote(str(target_root / '.current.next'))} "
        f"{shlex.quote(str(target_root / 'current'))}; "
        f"test \"$(readlink {shlex.quote(str(target_root / 'current'))})\" = "
        f"{shlex.quote(args.version)}"
    )
    run(["ssh", host, command], apply=args.apply)
    print(("selected" if args.apply else "dry-run rollback") +
          f" {args.target}/{args.version}")


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(required=True)
    send = commands.add_parser("publish")
    send.add_argument("release", type=Path)
    send.add_argument("destination", type=destination)
    send.add_argument("--apply", action="store_true")
    send.set_defaults(function=publish)
    back = commands.add_parser("rollback")
    back.add_argument("target", choices=TARGETS)
    back.add_argument("version")
    back.add_argument("destination", type=destination)
    back.add_argument("--apply", action="store_true")
    back.set_defaults(function=rollback)
    arguments = parser.parse_args(argv)
    if hasattr(arguments, "version") and not pxe_release.VERSION_PATTERN.fullmatch(arguments.version):
        parser.error("version must have form YYYYMMDD.NNN")
    try:
        arguments.function(arguments)
    except (ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(error, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
