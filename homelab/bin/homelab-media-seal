#!/usr/bin/env python3
"""Create or offline-verify the deterministic factory-media seal."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import media_seal  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("create", "verify"))
    parser.add_argument("--seal", type=Path, required=True)
    parser.add_argument("--arch-iso", type=Path, required=True)
    parser.add_argument("--arch-receipt", type=Path, required=True)
    parser.add_argument("--windows-iso", type=Path, required=True)
    parser.add_argument("--windows-provenance", type=Path, required=True)
    parser.add_argument("--windows-verification", type=Path, required=True)
    parser.add_argument("--windows-install-source", type=Path, required=True)
    parser.add_argument("--wimboot", type=Path, required=True)
    parser.add_argument("--wimboot-metadata", type=Path, required=True)
    args = parser.parse_args()
    repository = Path(__file__).resolve().parents[2]
    if subprocess.run(
        ["git", "-C", str(repository), "check-ignore", "--quiet",
         str(args.seal.absolute())],
        check=False,
    ).returncode:
        raise media_seal.SealError("seal receipt must be covered by ignore rules")
    receipt = media_seal.inventory(
        arch_iso=args.arch_iso,
        arch_receipt=args.arch_receipt,
        windows_iso=args.windows_iso,
        windows_provenance=args.windows_provenance,
        windows_verification=args.windows_verification,
        windows_install_source_path=args.windows_install_source,
        wimboot=args.wimboot,
        wimboot_metadata=args.wimboot_metadata,
    )
    if args.action == "create":
        media_seal.write(args.seal, receipt)
    else:
        media_seal.verify(args.seal, receipt)
    print(json.dumps(receipt, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, media_seal.SealError) as exc:
        raise SystemExit(f"error: {exc}")
