#!/usr/bin/env python3
"""Render, check, and verify the Telos GitHub Pages artifact.

Every page selects its own layout. This lets provider editions present a
project in genuinely different ways while retaining one small, audited build
pipeline and one explicit publication manifest.

    site check    Validate the manifest against the working tree.
    site build    Render build/site (add --serve to preview it).
    site verify   Re-check an already rendered build/site.
"""

from __future__ import annotations

import argparse
import html
import http.server
import json
import re
import shutil
import socketserver
import sys
from pathlib import Path, PurePosixPath
from urllib.parse import unquote, urlsplit

ROOT = Path(__file__).resolve().parents[1]
MANIFEST_PATH = ROOT / "site/site.json"
LAYOUT_ROOT = ROOT / "release/site/layouts"
ASSET_ROOT = ROOT / "release/site/assets"
DATA_ROOT = ROOT / "site/data"
DOC_ROOT = ROOT / "doc"
OUTPUT_ROOT = ROOT / "build/site"

MARKDOWN_LINK_RE = re.compile(r"(?<!\!)\[(?P<text>[^\]]*)\]\((?P<href>[^)\s]+)(?:\s+\"[^\"]*\")?\)")
HTML_REFERENCE_RE = re.compile(r"""(?:href|src)\s*=\s*["']([^"']+)["']""")
EXTERNAL_RE = re.compile(r"^(?:[A-Za-z][A-Za-z0-9+.-]*:|//|#|mailto:)")


class SiteError(RuntimeError):
    """A manifest, link, or artifact problem the operator must fix."""


# --------------------------------------------------------------------------
# Manifest
# --------------------------------------------------------------------------


def load_manifest() -> dict:
    if not MANIFEST_PATH.exists():
        raise SiteError(f"missing manifest: {MANIFEST_PATH.relative_to(ROOT)}")
    try:
        manifest = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise SiteError(f"manifest is not valid JSON: {error}") from error

    for field in ("title", "tagline", "navigation", "pages"):
        if field not in manifest:
            raise SiteError(f"manifest is missing required field: {field}")
    if not isinstance(manifest["pages"], list) or not manifest["pages"]:
        raise SiteError("manifest 'pages' must be a non-empty list")
    if not isinstance(manifest["navigation"], list) or not manifest["navigation"]:
        raise SiteError("manifest 'navigation' must be a non-empty list")

    seen_outputs: set[str] = set()
    for index, page in enumerate(manifest["pages"]):
        for field in ("source", "output", "title", "layout"):
            if field not in page:
                raise SiteError(f"page {index} is missing required field: {field}")
        output = page["output"]
        if output in seen_outputs:
            raise SiteError(f"duplicate page output: {output}")
        if output.startswith("/") or ".." in PurePosixPath(output).parts:
            raise SiteError(f"page output must be a relative path inside the site: {output}")
        layout = page["layout"]
        if (
            not isinstance(layout, str)
            or not re.fullmatch(r"[a-z0-9][a-z0-9-]*", layout)
        ):
            raise SiteError(f"page {index} has an invalid layout id: {layout!r}")
        if not (LAYOUT_ROOT / f"{layout}.html").is_file():
            raise SiteError(f"page {index} selects a missing layout: {layout}")
        body_class = page.get("body_class", "")
        if not isinstance(body_class, str) or not re.fullmatch(
            r"[a-z0-9 -]*", body_class
        ):
            raise SiteError(f"page {index} has invalid body_class tokens")
        seen_outputs.add(output)

    for index, item in enumerate(manifest["navigation"]):
        if not isinstance(item, dict) or not {"label", "output"} <= item.keys():
            raise SiteError(f"navigation item {index} requires label and output")
        if item["output"] not in seen_outputs:
            raise SiteError(
                f"navigation item {index} points to unpublished output: "
                f"{item['output']}"
            )
    return manifest


def page_sources(manifest: dict) -> list[tuple[dict, Path]]:
    resolved: list[tuple[dict, Path]] = []
    for page in manifest["pages"]:
        source = ROOT / page["source"]
        if not source.is_file():
            raise SiteError(f"page source does not exist: {page['source']}")
        resolved.append((page, source))
    return resolved


# --------------------------------------------------------------------------
# Link checking
# --------------------------------------------------------------------------


def local_targets(href: str) -> str | None:
    """Return the path portion of a site-local link, or None if it is external."""
    if EXTERNAL_RE.match(href):
        return None
    path = urlsplit(href).path
    return unquote(path) if path else None


def check_links(manifest: dict) -> tuple[list[str], set[str]]:
    """Validate every link out of every page. Returns (problems, referenced PDFs)."""
    problems: list[str] = []
    referenced_pdfs: set[str] = set()
    outputs = {page["output"] for page in manifest["pages"]}

    for page, source in page_sources(manifest):
        output_dir = PurePosixPath(page["output"]).parent
        text = source.read_text(encoding="utf-8")
        for match in MARKDOWN_LINK_RE.finditer(text):
            href = match.group("href")
            target = local_targets(href)
            if target is None or target == "":
                continue

            # Resolve the link the way a browser would: relative to the page's
            # own location in the rendered site, not to its Markdown source.
            resolved = PurePosixPath(target)
            if not target.startswith("/"):
                resolved = PurePosixPath(*(output_dir / target).parts)
            normalized = normalize(resolved)
            if normalized is None:
                problems.append(f"{page['source']}: link escapes the site root: {href}")
                continue

            # The renderer rewrites .md hrefs to .html, so a cross-page link is
            # written as the target page's output name with a .md suffix.
            # Check it the same way the renderer will resolve it.
            if normalized.endswith(".md"):
                normalized = normalized[: -len(".md")] + ".html"

            if normalized.endswith(".pdf"):
                if not (ROOT / normalized).is_file():
                    problems.append(f"{page['source']}: link to a PDF that is not in doc/: {href}")
                else:
                    referenced_pdfs.add(normalized)
            elif normalized.endswith(".html"):
                if normalized not in outputs:
                    problems.append(f"{page['source']}: link to an unpublished page: {href}")
            elif not (ROOT / normalized).exists():
                problems.append(f"{page['source']}: link to a missing file: {href}")

    return problems, referenced_pdfs


def normalize(path: PurePosixPath) -> str | None:
    """Collapse '.' and '..' segments, refusing anything that leaves the root."""
    parts: list[str] = []
    for part in path.parts:
        if part in ("", ".", "/"):
            continue
        if part == "..":
            if not parts:
                return None
            parts.pop()
            continue
        parts.append(part)
    return "/".join(parts)


def published_pdfs() -> set[str]:
    if not DOC_ROOT.is_dir():
        return set()
    return {
        pdf.relative_to(ROOT).as_posix()
        for pdf in DOC_ROOT.rglob("*.pdf")
        if pdf.is_file()
    }


# ADR 0046: the homelab record publishes a generic profile. Real addresses,
# hostnames and share paths belong in the gitignored instance overlay. This is
# the fail-closed check that decision requires, and it runs in CI where the
# overlay does not exist -- so a leak is caught by the absence of an excuse.
#
# The check runs in two passes because the two kinds of file have opposite
# rules. Published prose may name no address at all; code must name plenty, so
# there the gate flags every hardware-identifier-shaped token it cannot trace
# to a sanctioned synthetic range. Scanning only prose is how a captured
# workstation MAC, a captured disk serial and the real lab subnet reached the
# tests, the libraries and a fixture unchallenged.
RFC1918_ADDRESS = r"""(?:
      10\.\d{1,3}\.\d{1,3}\.\d{1,3}
    | 192\.168\.\d{1,3}\.\d{1,3}
    | 172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}
)"""
RFC1918_PATTERNS = (
    (re.compile(r"\b10\.\d{1,3}\.\d{1,3}\.\d{1,3}\b"), "RFC 1918 10/8 address literal"),
    (re.compile(r"\b192\.168\.\d{1,3}\.\d{1,3}\b"), "RFC 1918 192.168/16 address literal"),
    (re.compile(r"\b172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}\b"), "RFC 1918 172.16/12 address literal"),
)
INSTANCE_LEAK_PATTERNS = RFC1918_PATTERNS + (
    (re.compile(r"\b[a-z0-9-]+\.unas\b"), "NAS hostname"),
)
INSTANCE_SCANNED_ROOTS = ("src/homelab", "homelab/decisions", "site/pages")
INSTANCE_SCANNED_SUFFIXES = {".md", ".tex", ".json"}

# Pass two: the code that provisions the lab. Globs rather than roots so the
# top-level homelab narratives are covered without pulling in every sibling
# tree.
INSTANCE_CODE_GLOBS = (
    "homelab/*.md",
    "homelab/ansible/**/*",
    "homelab/lib/**/*",
    "homelab/tests/**/*",
    "homelab/vm/**/*",
)
INSTANCE_CODE_SUFFIXES = {".j2", ".json", ".md", ".ps1", ".py", ".yaml", ".yml"}
INSTANCE_CODE_PATTERNS = RFC1918_PATTERNS + (
    (re.compile(r"\b(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\b"), "MAC address"),
    # A vendor disk serial as lsblk reports it: the Samsung-style letter-digit
    # prefix, or a long digit run in a field that says what it is. The second
    # needs the field name -- a bare digit run of that length is far more often
    # a size or an integer bound.
    (re.compile(r"\bS[0-9][A-Z][0-9A-Z]{11,13}\b"), "vendor disk serial"),
    (re.compile(r"serial\W{1,8}\d{12,}", re.IGNORECASE), "vendor disk serial"),
    # A CIDR is a topology disclosure that its network address alone does not
    # carry: the size of the block says how the real site is subnetted. The
    # patterns above stop at the word boundary before the slash, so a real
    # supernet reached the tests wearing a network address that looks like a
    # documentation subnet in isolation and this host's real prefix length.
    # Matching the prefix length into the token makes INSTANCE_SANCTIONED judge
    # both halves, so a sanctioned network address with an unsanctioned prefix
    # length is now reported.
    (re.compile(rf"\b{RFC1918_ADDRESS}/\d{{1,3}}\b", re.VERBOSE), "RFC 1918 CIDR"),
)

# The synthetic ranges this project draws test values from. A token outside
# this set is assumed captured from real hardware until someone adds it here
# deliberately, which is the whole point: the addition is the review.
INSTANCE_SANCTIONED = re.compile(
    r"""^(?:
        # The bare 10/8 network address only. Sanctioning the whole 10.0.0.0/24
        # was the excuse that let a real default-gateway address sit in a test
        # unchallenged: a site whose first /24 is 10.0.0.0/24 has every one of
        # its hosts pre-excused. Code needs the network address (the CIDR
        # branches below carry the block sizes) and nothing else in that /24;
        # a synthetic host belongs in 10.1.x, which is sanctioned already.
          10\.0\.0\.0
        # QEMU user-mode networking, whose addresses are fixed by QEMU itself:
        # .2 is its gateway, .3 its DNS, .15 the first guest lease. The whole
        # /24 was sanctioned and no file used any of it, while 10.0.2.0/24 sits
        # inside this build host's real supernet -- an unused excuse for 256
        # real addresses. Widen only for another address QEMU itself fixes.
        | 10\.0\.2\.(?:2|3|15)
        | 10\.1\.\d{1,3}\.\d{1,3}                  # simulated lab, 10.1.31.0/24 and neighbours
        | 10\.[29]\.1\.\d{1,3}                     # simulated firewall's far networks
        | 172\.(?:16|31)\.\d{1,3}\.\d{1,3}         # generic documentation subnets
        | 192\.168\.\d{1,3}\.\d{1,3}               # generic documentation subnets
        # Sanctioned CIDRs. Separate from the address branches above because the
        # anchors here make the prefix length part of what must be excused: a
        # network address earns no excuse for the block size attached to it,
        # which is how a real supernet got through. Every prefix length below is
        # either an RFC-fixed private root or long enough that the block it
        # names is a single synthetic subnet rather than a site's topology.
        | 10\.0\.0\.0/(?:8|24)                     # RFC 1918 10/8 root; documentation subnet
        | 10\.1\.40\.0/21                          # simulated household supernet (deny-household)
        | 10\.1\.\d{1,3}\.\d{1,3}/(?:2[4-9]|3[0-3]) # simulated lab, /24 and longer only
        | 172\.16\.0\.0/12                         # RFC 1918 172.16/12 root
        | 192\.168\.0\.0/16                        # RFC 1918 192.168/16 root
        | 192\.168\.50\.0/30                       # documentation subnet, netplan unit test
        | 52:54:00(?::[0-9a-f]{2}){3}              # QEMU locally-administered MAC range
        | (?:aa:bb:cc|00:11:22)(?::[0-9a-f]{2}){3} # placeholder MACs
        | (?:00:00:00|01:00:00)(?::[0-9a-f]{2}){3} # the null MAC and the switch model's BPDU address
        # Carve-out: three vendor OUIs invented for the hardware-shape fixtures
        # before this gate existed. They are not this workstation's interfaces
        # (checked against /sys/class/net), so they stay until someone reissues
        # those fixtures in the 52:54:00 range.
        | (?:00:e0:4c|3c:ec:ef|a0:88:69)(?::[0-9a-f]{2}){3}
    )$""",
    re.VERBOSE | re.IGNORECASE,
)

# Carve-outs, per file and per finding so that exempting one class of token
# never quietly exempts the others. Every entry here is a leak this gate would
# otherwise report, held open because the file belongs to another owner;
# exempting them is what lets the gate widen now rather than after they settle.
# Delete each entry the moment its file is scrubbed.
INSTANCE_CODE_EXEMPT = {
    # Hardware-shape fixtures whose NVMe serials predate this gate, and the
    # acceptance test that must type them back verbatim. None of them is a disk
    # in this workstation (checked against /dev/disk/by-id).
    "homelab/tests/fixtures/uefi-mixed-nvme-sata.json": ("vendor disk serial",),
    "homelab/tests/fixtures/uefi-single-nvme.json": ("vendor disk serial",),
    "homelab/tests/test_acceptance.py": ("vendor disk serial",),
}


def check_instance_leaks() -> list[str]:
    """Refuse to publish a source file that names a real machine or address."""
    problems: list[str] = []
    prose = sorted(
        path
        for root_name in INSTANCE_SCANNED_ROOTS
        for path in (ROOT / root_name).rglob("*")
        if path.suffix in INSTANCE_SCANNED_SUFFIXES
    )
    problems.extend(scan_for_instance_data(prose, INSTANCE_LEAK_PATTERNS, None))
    code = sorted(
        path
        for glob in INSTANCE_CODE_GLOBS
        for path in ROOT.glob(glob)
        if path.suffix in INSTANCE_CODE_SUFFIXES
    )
    problems.extend(scan_for_instance_data(code, INSTANCE_CODE_PATTERNS, INSTANCE_SANCTIONED))
    return problems


def scan_for_instance_data(paths, patterns, sanctioned) -> list[str]:
    """Report every token `patterns` finds that `sanctioned` does not excuse."""
    problems: list[str] = []
    for path in paths:
        if not path.is_file() or path.name.endswith(".example.json"):
            continue
        relative = path.relative_to(ROOT).as_posix()
        exempt = INSTANCE_CODE_EXEMPT.get(relative, ())
        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            for pattern, description in patterns:
                if description in exempt:
                    continue
                for match in pattern.finditer(line):
                    if sanctioned is not None and sanctioned.match(match.group(0)):
                        continue
                    problems.append(
                        f"{relative}:{number}: {description} {match.group(0)!r} "
                        "in a published source (ADR 0046: use a placeholder and "
                        "put the real value in homelab/instance/)"
                    )
    return problems


def command_check(_: argparse.Namespace) -> int:
    manifest = load_manifest()
    problems, referenced = check_links(manifest)
    problems.extend(check_instance_leaks())

    available = published_pdfs()
    for orphan in sorted(available - referenced):
        problems.append(f"{orphan}: promoted into doc/ but linked from no page")

    if not LAYOUT_ROOT.is_dir():
        problems.append(f"missing layout root: {LAYOUT_ROOT.relative_to(ROOT)}")
    if not ASSET_ROOT.is_dir():
        problems.append(f"missing asset root: {ASSET_ROOT.relative_to(ROOT)}")

    if problems:
        for problem in problems:
            print(f"site: {problem}", file=sys.stderr)
        return 1
    print(
        f"site: {len(manifest['pages'])} pages, {len(available)} publications, "
        "all links resolve, no instance data in published sources"
    )
    return 0


# --------------------------------------------------------------------------
# Build
# --------------------------------------------------------------------------


def render_markdown(text: str) -> str:
    try:
        import markdown
    except ModuleNotFoundError as error:  # pragma: no cover - environment guard
        raise SiteError(
            "python-markdown is required; install it with "
            "'pip install -r requirements-site.txt' or 'pacman -S python-markdown'"
        ) from error
    renderer = markdown.Markdown(
        extensions=["extra", "sane_lists", "toc", "attr_list"],
        output_format="html5",
    )
    return renderer.convert(text)


def rewrite_page_links(body: str) -> str:
    """Point .md links at their rendered .html output, fragments included."""
    def replace(match: re.Match[str]) -> str:
        reference = match.group(1)
        if EXTERNAL_RE.match(reference):
            return match.group(0)
        # A cross-page link may carry a fragment: page.md#section.
        path, separator, fragment = reference.partition("#")
        if not path.endswith(".md"):
            return match.group(0)
        rewritten = path[: -len(".md")] + ".html" + separator + fragment
        return match.group(0).replace(reference, rewritten)

    return HTML_REFERENCE_RE.sub(replace, body)


def relative_prefix(output: str) -> str:
    depth = len(PurePosixPath(output).parts) - 1
    return "../" * depth


def build_navigation(manifest: dict, current: str) -> str:
    items: list[str] = []
    for item in manifest["navigation"]:
        label = item["label"]
        target = relative_prefix(current) + item["output"]
        current_root = item["output"] == "projects.html" and current.startswith("projects/")
        classes = ' class="current"' if item["output"] == current or current_root else ""
        items.append(f'<a href="{html.escape(target)}"{classes}>{html.escape(label)}</a>')
    return "\n".join(items)


def command_build(arguments: argparse.Namespace) -> int:
    manifest = load_manifest()
    problems, _ = check_links(manifest)
    if problems:
        for problem in problems:
            print(f"site: {problem}", file=sys.stderr)
        return 1

    if OUTPUT_ROOT.exists():
        shutil.rmtree(OUTPUT_ROOT)
    OUTPUT_ROOT.mkdir(parents=True)

    for page, source in page_sources(manifest):
        layout = (LAYOUT_ROOT / f"{page['layout']}.html").read_text(encoding="utf-8")
        body = rewrite_page_links(render_markdown(source.read_text(encoding="utf-8")))
        prefix = relative_prefix(page["output"])
        # The landing page's title is the site's title; "Telos — Telos" in a
        # browser tab helps nobody.
        head_title = page["title"]
        if head_title != manifest["title"]:
            head_title = f"{head_title} — {manifest['title']}"
        rendered = (
            layout.replace("{{head_title}}", html.escape(head_title))
            .replace("{{site_title}}", html.escape(manifest["title"]))
            .replace("{{tagline}}", html.escape(manifest["tagline"]))
            .replace(
                "{{description}}",
                html.escape(page.get("description", manifest["tagline"])),
            )
            .replace("{{title}}", html.escape(page["title"]))
            .replace("{{body_class}}", html.escape(page.get("body_class", "")))
            .replace("{{navigation}}", build_navigation(manifest, page["output"]))
            .replace("{{root}}", prefix)
            .replace("{{content}}", body)
        )
        destination = OUTPUT_ROOT / page["output"]
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(rendered, encoding="utf-8")

    shutil.copytree(ASSET_ROOT, OUTPUT_ROOT / "assets")
    if DATA_ROOT.is_dir():
        shutil.copytree(DATA_ROOT, OUTPUT_ROOT / "data")
    if DOC_ROOT.is_dir():
        shutil.copytree(DOC_ROOT, OUTPUT_ROOT / "doc")

    # GitHub Pages runs Jekyll unless told not to; the artifact is already HTML.
    (OUTPUT_ROOT / ".nojekyll").write_text("", encoding="utf-8")

    count = sum(1 for _ in OUTPUT_ROOT.rglob("*") if _.is_file())
    print(f"site: wrote {count} files to {OUTPUT_ROOT.relative_to(ROOT)}")

    if arguments.serve:
        serve(OUTPUT_ROOT, arguments.port)
    return 0


def serve(root: Path, port: int) -> None:
    class Handler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=str(root), **kwargs)

        def log_message(self, *args):  # quiet by default
            pass

    with socketserver.TCPServer(("127.0.0.1", port), Handler) as server:
        print(f"site: serving http://127.0.0.1:{port}/ (Ctrl-C to stop)")
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            print()


# --------------------------------------------------------------------------
# Verify
# --------------------------------------------------------------------------


def command_verify(_: argparse.Namespace) -> int:
    if not OUTPUT_ROOT.is_dir():
        raise SiteError("build/site does not exist; run 'make site' first")

    problems: list[str] = []
    for page in sorted(OUTPUT_ROOT.rglob("*.html")):
        relative = page.relative_to(OUTPUT_ROOT)
        for reference in HTML_REFERENCE_RE.findall(page.read_text(encoding="utf-8")):
            target = local_targets(reference)
            if target is None or target == "":
                continue
            if target.startswith("/"):
                resolved = PurePosixPath(target)
            else:
                resolved = PurePosixPath(relative.parent.as_posix()) / target
            normalized = normalize(resolved)
            if normalized is None or not (OUTPUT_ROOT / normalized).exists():
                problems.append(f"{relative}: dangling reference: {reference}")

    if not (OUTPUT_ROOT / ".nojekyll").is_file():
        problems.append("artifact is missing .nojekyll; GitHub Pages would run Jekyll on it")
    if not (OUTPUT_ROOT / "index.html").is_file():
        problems.append("artifact is missing index.html")

    if problems:
        for problem in problems:
            print(f"site: {problem}", file=sys.stderr)
        return 1
    pages = sum(1 for _ in OUTPUT_ROOT.rglob("*.html"))
    pdfs = sum(1 for _ in OUTPUT_ROOT.rglob("*.pdf"))
    print(f"site: verified {pages} pages and {pdfs} publications")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="site", description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("check", help="validate the manifest and links").set_defaults(
        handler=command_check
    )
    build = subparsers.add_parser("build", help="render build/site")
    build.add_argument("--serve", action="store_true", help="serve the artifact after rendering")
    build.add_argument("--port", type=int, default=8000, help="preview port (default 8000)")
    build.set_defaults(handler=command_build)
    subparsers.add_parser("verify", help="re-check a rendered artifact").set_defaults(
        handler=command_verify
    )

    arguments = parser.parse_args()
    try:
        return arguments.handler(arguments)
    except SiteError as error:
        print(f"site: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
