#!/usr/bin/env python3
"""Validate Telos' provider-neutral research exchange."""

from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
RESEARCH_ROOT = ROOT / "research"
CLAIM_ID = re.compile(
    r"\b[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-(?:[A-Z])?\d{3}\b"
)
HTTPS_URL = re.compile(r"https://[^\s)>]+")


def claim_ids(text: str) -> set[str]:
    """Return claim IDs from headings or the first cell of Markdown rows."""
    found: set[str] = set()
    for line in text.splitlines():
        heading = re.match(r"^#{2,6}\s+(\S+)", line)
        table = re.match(r"^\|\s*([^| ]+)\s*\|", line)
        bullet = re.match(r"^-\s+\*\*(\S+)\*\*", line)
        candidate = (
            heading.group(1)
            if heading
            else table.group(1)
            if table
            else bullet.group(1)
            if bullet
            else ""
        )
        if CLAIM_ID.fullmatch(candidate):
            found.add(candidate)
    return found


def display(path: Path) -> str:
    try:
        return path.relative_to(ROOT).as_posix()
    except ValueError:
        return path.as_posix()


def validate() -> list[str]:
    problems: list[str] = []
    owners: dict[str, str] = {}
    projects = sorted(
        path for path in RESEARCH_ROOT.iterdir()
        if path.is_dir() and not path.name.startswith(".")
    )
    if not projects:
        return ["research/: no project research directories"]

    for project in projects:
        relative = display(project)
        sources = project / "sources.md"
        claims = project / "claims.md"
        selections = sorted(project.glob("*-selection.md"))
        for required in (sources, claims):
            if not required.is_file():
                problems.append(f"{relative}: missing {required.name}")
        if not selections:
            problems.append(f"{relative}: no provider selection manifest")
        if not sources.is_file() or not claims.is_file():
            continue

        source_text = sources.read_text(encoding="utf-8")
        if not HTTPS_URL.search(source_text):
            problems.append(f"{relative}/sources.md: no direct HTTPS source")

        known = claim_ids(claims.read_text(encoding="utf-8"))
        if not known:
            problems.append(f"{relative}/claims.md: no stable claim IDs")
        for claim in sorted(known):
            prior = owners.get(claim)
            if prior:
                problems.append(
                    f"{relative}/claims.md: claim ID {claim} already belongs to {prior}"
                )
            else:
                owners[claim] = relative

        for selection in selections:
            selected = set(CLAIM_ID.findall(selection.read_text(encoding="utf-8")))
            if not selected:
                problems.append(
                    f"{display(selection)}: references no atomic claim IDs"
                )
                continue
            for unknown in sorted(selected - known):
                problems.append(
                    f"{display(selection)}: unknown claim ID {unknown}"
                )
    return problems


def main() -> int:
    problems = validate()
    if problems:
        for problem in problems:
            print(f"research: {problem}", file=sys.stderr)
        return 1
    project_count = sum(1 for path in RESEARCH_ROOT.iterdir() if path.is_dir())
    print(f"research: {project_count} project libraries resolve")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
